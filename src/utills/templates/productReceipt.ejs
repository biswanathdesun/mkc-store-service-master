<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receipt</title>
    <style>
        body {
            font-family: Arial, sans-serif !important;
            margin: 0 !important;
            padding: 0 !important;
            background-color: #f5f5f5 !important;
        }

        .receipt {
            width: 100% !important;
            height: 100% !important;
            background-color: white !important;
            padding: 20px !important;
        }

        .header {
            margin-bottom: 5px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            text-align: center;
        }

        .header h1,
        .header h3 {
            margin: 0;
        }

        .logo {
            height: 70px !important;
            width: 70px !important;
            display: inline-block !important;
            vertical-align: middle !important;
        }

        .company-details {
            display: inline-block !important;
            margin-left: 3px !important;
            vertical-align: middle !important;
            text-align: center !important;
        }

        .company-details h1 {
            font-size: 16px;
            margin-bottom: 2px;
            line-height: 1;
        }

        .company-details h3 {
            font-size: 8px;
            margin: 0px;
            line-height: 1;
        }

        .table {
            margin-top: 10px !important;
            width: 95% !important;
            border-collapse: collapse !important;
        }

        .table th,
        .table td {
            border: 1px solid #070707 !important;
            text-align: left !important;
            padding: 3px !important;
            font-size: 9px !important;
        }

        .table tr th {
            font-weight: 600 !important;
        }

        .table tr td {
            font-weight: 400 !important;
            font-size: 8px !important;
        }
    </style>
</head>

<body>
    <div class="receipt">
        <div class="header" style="display: flex; justify-content: space-between;">
            <h2 style="font-size: 11px; margin: 2px 0;">Receipt</h2>
            <h2 style="font-size: 8px;">GST NO.: <%= gstNo %>
            </h2>
        </div>

        <div style="margin-top: 10px; display: flex; align-items: start; text-align: start;">
            <div class="logo">
                <img style="height: 100%; width: 100%;" src="<%= logoLink %>" alt="Company Logo" />
            </div>
            <div class="company-details" style="margin-left: 10px;">
                <h1 style="font-size: 18px; margin-bottom: 2px; line-height: 1;">
                    <%= InstituteName %>
                </h1>
                <h3 style="font-size: 8px; margin: 0px; line-height: 1;">
                    <%= address %>
                </h3>
            </div>
        </div>

        <table class="table">
            <tr>
                <th>Receipt No:</th>
                <td>
                    <%=reciptNumber%>
                </td>
                <th>Enrollment No:</th>
                <td>
                    <%=EnrollmentNo%>
                </td>
                <th>Date:</th>
                <td>
                    <%=currentDate%>
                </td>
            </tr>
            <tr rowspan="2">
                <th>
                    <p>Name:</p>
                </th>
                <td colspan="2">
                    <%=studentName%>
                </td>
                <th>Course:</th>
                <td colspan="2">
                    <%=courseName%>
                </td>
            </tr>
            <tr rowspan="2">
                <th>
                    <p>S/O:</p>
                </th>
                <td colspan="2">
                    <%=parentName%>
                </td>
                <th colspan="1">Batch :</th>
                <td colspan="2">
                    <%=Batch%>
                </td>
            </tr>
            <tr>
                <th>Joining Date:</th>
                <td>
                    <%=joiningDate%>
                </td>
                <th>Ending Date:</th>
                <td>
                    <%=EndingDate%>
                </td>
                <th>Status:</th>
                <td>
                    <%=status%>
                </td>
            </tr>
            <tr>
                <th>S.No</th>
                <th>Particular</th>
                <th>Code :</th>
                <th>Mode</th>
                <th>Bank Details</th>
                <th>Amount</th>
            </tr>
            <%items.forEach((item, index)=> {%>
                <tr>
                    <th>
                        <%= index + 1%>
                    </th>
                    <th>
                        <%= item.type%> Fee
                    </th>
                    <th>
                        <%=item.Code%>
                    </th>
                    <th>
                        <%=item.Mode%>
                    </th>
                    <th>
                        <%=item.BankDetails%>
                    </th>
                    <td>
                        <%=item.totalPrice%>
                    </td>
                </tr>
                <%})%>
                    <tr>
                        <th colspan="3" rowspan="2" style="text-align: center;">Authorized Signatory</th>
                        <td colspan="2">CGST@<%=cgstPercentage%>%</td>
                        <td>Rs. <%=cgst%>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">SGST@<%=sgstPercentage%>%</td>
                        <td>Rs. <%=sgst%>
                        </td>
                    </tr>

                    <tr>
                        <th colspan="3" rowspan="2" style="text-align: left;">
                            <p>Note:- Fees is Non Refundable & Non Adjustable</p>
                        </th>
                        <th colspan="2">Total</th>
                        <td>Rs. <%=totalPrice%>
                        </td>
                    </tr>
        </table>
        <% if (dueAmount && dueDate) { %>
            <h3 style="font-size: 9px; margin: 3px 0px; line-height: 1;">
                Dues Amount: <%= dueAmount %> | Dues Date: <%= dueDate %>
            </h3>
            <% } %>
    </div>
</body>

</html>
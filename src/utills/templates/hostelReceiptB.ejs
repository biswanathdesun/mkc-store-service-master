<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hostel A Receipt</title>
    <style>
      body {
        font-family: Arial, sans-serif !important;
        margin: 0 !important;
        padding: 0 !important;
        background-color: #f5f5f5 !important;
      }

      .receipt {
        background-color: white !important;
        padding: 20px !important;
      }

      .header {
        text-align: center !important;
        margin-bottom: 10px !important;
      }

      .table {
        width: 100% !important;
        border: 1px solid #070707 !important;
        border-collapse: collapse !important;
        margin-bottom: 20px !important;
      }

      .table th,
      .table td {
        border: 1px solid #070707 !important;
        padding: 5px !important;
        text-align: left !important;
        font-size: 8px;
      }

      .table th {
        font-weight: 700;
      }

      .company-info {
        margin-right: 130px;
      }
    </style>
  </head>

  <body>
    <div class="receipt">
      <div class="header">
        <h2 style="font-size: 10px">Receipt</h2>
        <div style="padding-bottom: 5px">
          <img
            style="width: 80px; float: left; margin-left: 70px"
            src="<%= data?.logoLink %>"
            alt="Company Logo"
          />
          <div class="company-info">
            <h4 style="margin-bottom: 3px; font-size: 10px">
              MKC HOSTEL PRIVATE LIMITED
            </h4>
            <span style="margin: 0; font-size: 8px"> 25/35 Hashimpur Road</span>
            <span style="margin: 0; font-size: 8px">Tagore town prayagraj</span>
            <div style="margin: 0; font-size: 8px">
              Contact: 9151333831, 7388159444
            </div>
            <div style="margin: 0; font-size: 8px">
              E-Mail: mkchostel@gmail.com
            </div>
          </div>
        </div>
      </div>
      <table class="table">
        <tr>
          <th>Receipt No:</th>
          <td><%= data?.receiptNumber %></td>
          <th>Enrollment No:</th>
          <td><%= data?.enrollmentNumber %></td>
          <th>Date:</th>
          <td><%= data?.paymentDate %></td>
        </tr>
        <tr style="height: 8px">
          <th>Name:</th>
          <td colspan="2"><%= data?.name %></td>
          <th style="width: 60px; min-width: 50px; max-width: 100px">
            Course:
          </th>
          <td colspan="2"><%= data?.course %></td>
        </tr>
        <tr style="height: 8px">
          <th>S/O:</th>
          <td colspan="2"><%= data?.parentName %></td>
          <th colspan="1">Batch :</th>
          <td colspan="2"><%= data?.batch %></td>
        </tr>

        <tr style="height: 8px">
          <th>Hostel:</th>
          <td colspan="2"><%= data?.hostel %></td>
          <th colspan="1">Room No:</th>
          <td colspan="2"><%= data?.roomDetails %></td>
        </tr>
        <tr>
          <th>S.No</th>
          <th colspan="2">Particular</th>
          <th>Mode</th>
          <th>Bank Details</th>
          <th>Amount</th>
        </tr>
        <% if (data?.paymentDetails && data?.paymentDetails.length> 0) { %> <%
        data?.paymentDetails.forEach((detail, index)=> { %>
        <tr>
          <th><%= index + 1 %></th>
          <th colspan="2"><%= detail.name %></th>
          <th><%= detail.mode %></th>
          <th><%= detail.bankDetails %></th>
          <td><%= detail.amount.toFixed(2) %></td>
        </tr>
        <% }) %> <% } else { %>
        <tr>
          <td colspan="6">No payment details available</td>
        </tr>
        <% } %> <% if (data?.isGstApplicable) { %>
        <tr>
          <th
            colspan="3"
            rowspan="2"
            style="text-align: center; position: relative !important"
          >
            <div>Authorized Signatory</div>

            <span
              style="
                font-size: 8px !important;
                position: absolute;
                bottom: 0;
                left: 1%;
                transform: translateX(-50%);
              "
            >
              Hostel: <%= data?.hostelGstAmount %> Accommodation: <%=
              data?.accommodationGstAmount %> Meal: <%= data?.mealGstAmount %>
            </span>
          </th>
          <td colspan="2">CGST</td>
          <td rowspan="1">Rs.<%= data?.cgstAmount %></td>
        </tr>
        <tr>
          <td colspan="2">SGST</td>
          <td>Rs.<%= data?.sgstAmount %></td>
        </tr>

        <% } %>
        <tr>
          <th colspan="3" rowspan="2" style="text-align: left">
            <p>Note:- Fees is Non Refundable & Non Adjustable</p>
          </th>
          <th colspan="2">Total</th>
          <td>Rs.<%= data?.totalAmtReceived %></td>
        </tr>
      </table>
      <% if (data && data.nextPaymentDate && data.outstandingAmount) { %>
      <h4 style="margin-left: 10px; font-weight: 700; font-size: 10px">
        Due Amount: <%= data.outstandingAmount %> | Due Date: <%=
        data.nextPaymentDate %>
      </h4>
      <% } else if (data && data.nextPaymentDate) { %>
      <h4 style="margin-left: 10px; font-weight: 700; font-size: 10px">
        Due Date: <%= data.nextPaymentDate %>
      </h4>
      <% } else if (data && data.outstandingAmount) { %>
      <h4 style="margin-left: 10px; font-weight: 700; font-size: 10px">
        Due Amount: <%= data.outstandingAmount %>
      </h4>
      <% } %>
    </div>
  </body>
</html>

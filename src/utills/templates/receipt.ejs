<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Receipt</title>
    <style>
        body {
            font-family: Arial, sans-serif !important;
            margin: 0 !important;
            padding: 0 !important;
            background-color: #f5f5f5 !important;
        }

        .receipt {
            width: 80% !important;
            margin: 10px auto !important;
            background-color: white !important;
            padding: 20px !important;
        }

        .header {
            text-align: center !important;
            margin-bottom: 10px !important;
            font-size: 15px;
        }

        .address {
            margin-bottom: 20px !important;
            font-size: 12px;
        }

        .details {
            margin-bottom: 20px !important;
        }

        .table {
            width: 100% !important;
            border-collapse: collapse !important;
            margin-bottom: 20px !important;
        }

        .table th,
        .table td {
            border: 2px solid #070707 !important;
            padding: 5px !important;
            text-align: left !important;
            font-size: 10px;
        }
    </style>
</head>

<body>
    <div class="receipt">
        <div class="header">
            <h2>Receipt</h2>
            <h2 style="text-align: end">GST NO.: ${gstNo}</h2>
            <div style="display: flex;">
                <img style="height: 10px; width: 20px; margin-right: 30px;" src="/MKC Logo New.png"
                    alt="Company Logo" />

                <div class="company-info">
                    <h1>
                        <%=InstituteName%>
                    </h1>
                    <h3>
                        <%=address%>
                    </h3>
                </div>
            </div>
        </div>
        <table class="table">
            <tr>
                <th>Receipt No:</th>
                <td>
                    <%=reciptNumber%>
                </td>
                <th>Enrollment No:</th>
                <td>
                    <%=EnrollmentNo%>
                </td>
                <th>Date:</th>
                <td>
                    <%=currentDate%>
                </td>
            </tr>
            <tr style="height: 10px">
                <th>
                    <p>Name:</p>
                </th>
                <td colspan="2">
                    <%=studentName%>
                </td>
                <th style="width: 60px; min-width: 50px; max-width: 100px;">Course:</th>
                <td colspan="2">
                    <%=courseName%>
                </td>
            </tr>
            <tr style="height: 10px">
                <th>
                    <p>S/O:</p>
                </th>
                <td colspan="2">
                    <%=parentName%>
                </td>
                <th colspan="1">Batch :</th>
                <td colspan="2">
                    <%=Batch%>
                </td>
            </tr>
            <tr>
                <th>Joining Date:</th>
                <td>
                    <%=joiningDate%>
                </td>
                <th>Ending Date:</th>
                <td>
                    <%=EndingDate%>
                </td>
                <th>Status:</th>
                <td>
                    <%=status%>
                </td>
            </tr>
            <tr>
                <th>S.No</th>
                <th>Particular</th>
                <th>Code :</th>
                <th>Mode</th>
                <th>Bank Details</th>
                <th>Amount</th>
            </tr>
            <tr>
                <th>1</th>
                <th>*Course Fee</th>
                <th>
                    <%=Code%>
                </th>
                <th>
                    <%=Mode%>
                </th>
                <th>
                    <%=BankDetails%>
                </th>
                <td>
                    <%=Amount%>
                </td>
            </tr>
            <tr>
                <th colspan="3" rowspan="2" style="text-align: center;">Authorized Signatory</th>
                <td colspan="2">CGST@<%=cgstPercentage%>%</td>
                <th rowspan="1">Rs.<%=cgst%>
                </th>
            </tr>
            <tr>
                <th colspan="2">SGST@<%=sgstPercentage%>%</th>
                <td>Rs.<%=sgst%>
                </td>
            </tr>
            <tr>
                <th colspan="3" rowspan="2" style="text-align: left;">
                    <p>Note:- Fees is Non Refundable & Non Adjustable</p>
                </th>
                <th colspan="2">Total</th>
                <td>Rs.<%=totalPrice%>
                </td>
            </tr>
        </table>
        <h4 style="margin-left: 10px; font-weight: 700;">ISSUE</h4>
    </div>
</body>

</html>
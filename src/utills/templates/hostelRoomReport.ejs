<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hostel Room Report</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        .container {
            padding: 20px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #000;
            margin-bottom: 20px;
        }

        .header h2 {
            text-align: center !important;
            margin: 0;
            font-size: 12px;
        }

        .header .date {
            font-size: 16px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        table,
        th,
        td {
            border: 1px solid #000;
            padding: 4px;
            text-align: left;
            font-size: 7px;
            word-wrap: break-word;
        }

        th,
        td {
            padding: 4px;
            text-align: left;
        }

        th {
            background-color: #f4f4f4;
        }
    </style>
</head>

<body>
    <div class="container">
        <p style="text-align: right; font-size: 8px">
            <%= date %>
        </p>

        <div class="header">
            <h2 style="padding-bottom: 5px;">
                <%= hostelName %>
            </h2>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Bed Type</th>
                    <th>Floor Number</th>
                    <th>Room Number</th>
                    <th>Phone</th>
                    <th>Validity End Date</th>
                </tr>
            </thead>
            <tbody>
                <% data.forEach(function(item) { %>
                    <tr>
                        <td>
                            <%= item.userName %>
                        </td>
                        <td>
                            <%= item.bedType %>
                        </td>
                        <td>
                            <%= item.floorNumber %>
                        </td>
                        <td>
                            <%= item.roomNumber %>
                        </td>
                        <td>
                            <%= item.phone %>
                        </td>
                        <td>
                            <%= item.validityEndDate %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
    </div>
</body>

</html>
